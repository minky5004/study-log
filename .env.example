# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 gitignore 대상이다.
#
# 비밀번호는 평문이 아니라 BCrypt 해시로 넣는다. 도커만 있으면 한 줄로 얻는다.
#   docker run --rm httpd:alpine htpasswd -bnBC 10 "" 원하는비밀번호 | tr -d ':\n'
#
# 해시에는 $ 가 들어 있고 컴포즈는 따옴표 없는 값에서 $ 를 변수로 읽는다.
# 작은따옴표로 감싼 채로 둘 것.

APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD_HASH='$2y$10$여기에_생성한_해시'
